    {
      "start": 3.52,
      "end": 6.56,
      "lines": [
        {
          "text": "We're rolling.",
          "start": 3.52,
          "end": 4.4
        },
        {
          "text": "I don't know why you need that tape recorder.",
          "start": 4.6,
          "end": 6.56
