{
  "id": "Dd7FixvoKBw",
  "segments": [
    {
      "start": 2.34,
      "end": 7.04,
      "lines": [
        {
          "text": "- ALL RIGHT, LISTEN UP, Y'ALL.",
          "start": 2.34,
          "end": 4.07
        },
        {
          "text": "I'M Y'ALL'S SUBSTITUTE TEACHER, MR. GARVEY.",
          "start": 4.1,
          "end": 7.04
        }
      ],
      "glossary": [
        {
          "term": "listen up",
          "ko": "잘 들어, 주목해",
          "type": "idiom"
        },
        {
          "term": "substitute teacher",
          "ko": "대체 교사, 기간제 교사",
          "type": "phrase"
        }
      ]
    },
    {
      "start": 7.07,
      "end": 15.42,
      "lines": [
        {
          "text": "I TAUGHT SCHOOL FOR 20 YEARS IN THE INNER CITY, SO DON'T EVEN THINK ABOUT MESSING WITH ME.",
          "start": 7.07,
          "end": 13.11
        },
        {
          "text": "Y'ALL FEEL ME? - MM-HMM.",
          "start": 13.15,
          "end": 15.42
        }
      ],
      "glossary": [
        {
          "term": "inner city",
          "ko": "도심 빈민가",
          "type": "phrase"
        },
        {
          "term": "mess with",
          "ko": "건드리다, 까불다",
          "type": "phrase"
        },
        {
          "term": "feel me",
          "ko": "(속어) 내 말 알아듣겠어?",
          "type": "idiom"
        }
      ]
    },
    {
      "start": 15.45,
      "end": 22.89,
      "lines": [
        {
          "text": "- OKAY. LET'S TAKE ROLL HERE.",
          "start": 15.45,
          "end": 18.95
        },
        {
          "text": "JAY QUELLIN.",
          "start": 18.99,
          "end": 22.89
        }
      ],
      "glossary": [
        {
          "term": "take roll",
          "ko": "출석을 부르다",
          "type": "idiom"
        }
      ]
    },
    {
      "start": 22.92,
      "end": 27.83,
      "lines": [
        {
          "text": "WHERE'S JAY QUELLIN AT?",
          "start": 22.92,
          "end": 24.46
        },
        {
          "text": "NO JAY QUELLIN HERE?",
          "start": 24.49,
          "end": 27.83
        }
      ]
    },
    {
      "start": 27.86,
      "end": 31.93,
      "lines": [
        {
          "text": "- [clears throat] - YEAH.",
          "start": 27.86,
          "end": 29.3
        },
        {
          "text": "- UH, DO YOU MEAN JACQUELINE?",
          "start": 29.33,
          "end": 31.93
        }
      ]
    },
    {
      "start": 31.97,
      "end": 36.37,
      "lines": [
        {
          "text": "- OKAY. SO THAT'S HOW IT'S GONNA BE.",
          "start": 31.97,
          "end": 34.97
        },
        {
          "text": "Y'ALL WANNA PLAY.",
          "start": 35,
          "end": 36.37
        }
      ],
      "glossary": [
        {
          "term": "that's how it's gonna be",
          "ko": "그렇게 나오시겠다 이거지",
          "type": "idiom"
        }
      ]
    },
    {
      "start": 36.4,
      "end": 41.21,
      "lines": [
        {
          "text": "OKAY, THEN.",
          "start": 36.4,
          "end": 38.51
        },
        {
          "text": "I GOT MY EYE ON YOU, JAY QUELLIN.",
          "start": 38.54,
          "end": 41.21
        }
      ],
      "glossary": [
        {
          "term": "got my eye on you",
          "ko": "너 주시하고 있어, 지켜보고 있어",
          "type": "idiom"
        }
      ]
    },
    {
      "start": 44.48,
      "end": 49.75,
      "lines": [
        {
          "text": "BALAKAY.",
          "start": 44.48,
          "end": 46.71
        },
        {
          "text": "WHERE IS BALAKAY AT?",
          "start": 46.75,
          "end": 49.75
        }
      ]
    },
    {
      "start": 49.78,
      "end": 54.69,
      "lines": [
        {
          "text": "THERE'S NO BALAKAY HERE TODAY?",
          "start": 49.78,
          "end": 53.69
        },
        {
          "text": "YES, SIR.",
          "start": 53.72,
          "end": 54.69
        }
      ]
    },
    {
      "start": 54.72,
      "end": 60.49,
      "lines": [
        {
          "text": "- MY NAME IS BLAKE. - BL...",
          "start": 54.72,
          "end": 58.06
        },
        {
          "text": "ARE YOU OUT OF YOUR GODDAMN MIND?",
          "start": 58.09,
          "end": 60.49
        }
      ],
      "glossary": [
        {
          "term": "out of your goddamn mind",
          "ko": "제정신이 아니다, 미쳤다",
          "type": "idiom"
        }
      ]
    },
    {
      "start": 60.53,
      "end": 65.07,
      "lines": [
        {
          "text": "[mocking voice] BLAKE. WHAT?",
          "start": 60.53,
          "end": 63.16
        },
        {
          "text": "DO YOU WANNA GO TO WAR, BALAKEY? - NO.",
          "start": 63.2,
          "end": 65.07
        }
      ],
      "glossary": [
        {
          "term": "mocking voice",
          "ko": "비웃는 말투",
          "type": "phrase"
        },
        {
          "term": "go to war",
          "ko": "한판 붙다, 전쟁하다",
          "type": "idiom"
        }
      ]
    },
    {
      "start": 65.1,
      "end": 70.4,
      "lines": [
        {
          "text": "- 'CAUSE WE COULD GO TO WAR. - NO.",
          "start": 65.1,
          "end": 66.8
        },
        {
          "text": "- I'M FOR REAL. I'M FOR REAL.",
          "start": 66.83,
          "end": 70.4
        }
      ]
    },
    {
      "start": 70.44,
      "end": 77.54,
      "lines": [
        {
          "text": "SO YOU BETTER CHECK YOURSELF.",
          "start": 70.44,
          "end": 74.68
        },
        {
          "text": "DEE-NICE.",
          "start": 74.71,
          "end": 77.54
        }
      ],
      "glossary": [
        {
          "term": "check yourself",
          "ko": "(속어) 까불지 마, 정신 차려",
          "type": "idiom"
        }
      ]
    },
    {
      "start": 77.58,
      "end": 85.75,
      "lines": [
        {
          "text": "IS THERE A DEE-NICE?",
          "start": 77.58,
          "end": 81.38
        },
        {
          "text": "IF ONE OF Y'ALL SAYS SOME SILLY-ASS NAME...",
          "start": 81.42,
          "end": 85.75
        }
      ]
    },
    {
      "start": 85.79,
      "end": 92.53,
      "lines": [
        {
          "text": "THIS WHOLE CLASS IS GONNA FEEL MY WRATH.",
          "start": 85.79,
          "end": 89.72
        },
        {
          "text": "NOW, DEE-NICE. - DO YOU MEAN DENISE?",
          "start": 89.76,
          "end": 92.53
        }
      ],
      "glossary": [
        {
          "term": "feel my wrath",
          "ko": "내 분노를 맛보다",
          "type": "idiom"
        }
      ]
    },
    {
      "start": 92.56,
      "end": 97.87,
      "lines": [
        {
          "text": "- SON OF A BITCH!",
          "start": 92.56,
          "end": 95.86
        },
        {
          "text": "YOU SAY YOUR NAME RIGHT, RIGHT NOW.",
          "start": 95.9,
          "end": 97.87
        }
      ]
    },
    {
      "start": 97.9,
      "end": 100.1,
      "lines": [
        {
          "text": "- DENISE? - YOU SAY IT RIGHT.",
          "start": 97.9,
          "end": 99
        },
        {
          "text": "- DENISE. - CORRECTLY.",
          "start": 99.1,
          "end": 100.1
        }
      ]
    },
    {
      "start": 100.1,
      "end": 103.34,
      "lines": [
        {
          "text": "- DENISE. - RIGHT.",
          "start": 100.1,
          "end": 102.1
        },
        {
          "text": "- DEE-NICE. - THAT'S BETTER.",
          "start": 102.14,
          "end": 103.34
        }
      ]
    },
    {
      "start": 103.37,
      "end": 108.11,
      "lines": [
        {
          "text": "- [sighs] - THANK YOU.",
          "start": 103.37,
          "end": 104.47
        },
        {
          "text": "NOW, AY-AY-RON.",
          "start": 104.51,
          "end": 108.11
        }
      ]
    },
    {
      "start": 108.11,
      "end": 113.18,
      "lines": [
        {
          "text": "WHERE ARE YOU?",
          "start": 108.11,
          "end": 109.91
        },
        {
          "text": "WHERE IS AY-AY-RON RIGHT NOW?",
          "start": 109.94,
          "end": 113.18
        }
      ]
    },
    {
      "start": 113.21,
      "end": 119.95,
      "lines": [
        {
          "text": "NO AY-AY RON, HUH?",
          "start": 113.21,
          "end": 115.12
        },
        {
          "text": "WELL, YOU BETTER BE SICK, DEAD, OR MUTE, AY-AY-RON!",
          "start": 115.12,
          "end": 119.95
        }
      ],
      "glossary": [
        {
          "term": "mute",
          "ko": "말을 못 하는, 벙어리의",
          "type": "word"
        }
      ]
    },
    {
      "start": 120.05,
      "end": 125.39,
      "lines": [
        {
          "text": "- HERE. OH, MAN.",
          "start": 120.05,
          "end": 123.56
        },
        {
          "text": "- WHY DIDN'T YOU ANSWER ME THE FIRST TIME I SAID IT, HUH?",
          "start": 123.59,
          "end": 125.39
        }
      ]
    },
    {
      "start": 125.43,
      "end": 128.5,
      "lines": [
        {
          "text": "- HUH? - YOU KNOW, I'M JUST ASKING YOU.",
          "start": 125.43,
          "end": 126.86
        },
        {
          "text": "I SAID IT, LIKE, FOUR TIMES.",
          "start": 126.89,
          "end": 128.5
        }
      ]
    },
    {
      "start": 128.53,
      "end": 136.57,
      "lines": [
        {
          "text": "SO WHY DIDN'T YOU SAY IT THE FIRST TIME I SAID, \"AY-AY-RON?\"",
          "start": 128.53,
          "end": 132.37
        },
        {
          "text": "- BECAUSE IT'S PRONOUNCED \"AARON.\"",
          "start": 135.07,
          "end": 136.57
        }
      ]
    },
    {
      "start": 136.6,
      "end": 152.22,
      "lines": [
        {
          "text": "- SON OF A BITCH! [clattering] YOU DONE MESSED UP, AY-AY RON, NOW TAKE YOUR ASS ON DOWN TO OH-SHAG-HENNESY'S OFFICE RIGHT NOW AND TELL HIM EXACTLY WHAT YOU DID!",
          "start": 136.6,
          "end": 148.38
        },
        {
          "text": "- WHO? - OH-SHAG-HENNESY!",
          "start": 148.42,
          "end": 152.22
        }
      ],
      "glossary": [
        {
          "term": "you done messed up",
          "ko": "(속어) 너 큰일 났어, 일 제대로 그르쳤어",
          "type": "idiom"
        },
        {
          "term": "take your ass down to",
          "ko": "(속어) 당장 ~로 가",
          "type": "idiom"
        }
      ]
    },
    {
      "start": 152.25,
      "end": 157.52,
      "lines": [
        {
          "text": "- PRINCIPAL O'SHAUGHNESSY?",
          "start": 152.25,
          "end": 153.35
        },
        {
          "text": "- GET OUT OF MY GODDAMN CLASSROOM BEFORE I BREAK MY FOOT OFF IN YOUR ASS!",
          "start": 153.39,
          "end": 157.52
        }
      ],
      "glossary": [
        {
          "term": "break my foot off in your ass",
          "ko": "(속어) 아주 혼쭐을 내주다",
          "type": "idiom"
        }
      ]
    },
    {
      "start": 157.56,
      "end": 162.93,
      "lines": [
        {
          "text": "INSUBORDINATE...",
          "start": 157.56,
          "end": 159.86
        },
        {
          "text": "AND CHURLISH.",
          "start": 159.89,
          "end": 162.93
        }
      ],
      "glossary": [
        {
          "term": "insubordinate",
          "ko": "반항적인, 명령에 불복하는",
          "type": "word"
        },
        {
          "term": "churlish",
          "ko": "무례한, 상스러운",
          "type": "word"
        }
      ]
    },
    {
      "start": 166.5,
      "end": 170.37,
      "lines": [
        {
          "text": "TYM-OH-THEE.",
          "start": 166.5,
          "end": 168.4
        },
        {
          "text": "- PRESENT. - THANK YOU!",
          "start": 168.44,
          "end": 170.37
        }
      ],
      "glossary": [
        {
          "term": "present",
          "ko": "(점호 대답) 출석했습니다, 여기요",
          "type": "word"
        }
      ]
    }
  ]
}
