{
  "id": "6rUYCefYMMY",
  "segments": [
    {
      "start": 2.32,
      "end": 5.16,
      "lines": [
        {
          "text": "What are you boys doing?",
          "start": 2.32,
          "end": 3.48
        },
        {
          "text": "We're going to the basement to wrestle.",
          "start": 3.48,
          "end": 5.16
        }
      ]
    },
    {
      "start": 5.2,
      "end": 9.76,
      "lines": [
        {
          "text": "But wrestling's dangerous.",
          "start": 5.2,
          "end": 6.76
        },
        {
          "text": "Not the way we do it Mother. We never actually get physical.",
          "start": 6.76,
          "end": 9.76
        }
      ]
    },
    {
      "start": 9.84,
      "end": 15.84,
      "lines": [
        {
          "text": "It's all about the pageantry.",
          "start": 9.84,
          "end": 11.96
        },
        {
          "text": "Now you're just dangerously close to me calling you a pu**y.",
          "start": 13.08,
          "end": 15.84
        }
      ],
      "glossary": [
        {
          "term": "It's all about the pageantry",
          "ko": "중요한 건 화려한 쇼/볼거리야",
          "type": "idiom",
          "easy": "실제 내용보다 보여주기 위한 화려한 연출이 핵심이라는 말.",
          "nuance": "pageantry는 보기 좋게 꾸민 '겉치레 쇼' 느낌. 진짜 싸움이 아니라 보여주기용이라는 뜻.",
          "when": "행사·공연·프로레슬링처럼 '내용보다 보여주기'가 중요할 때.",
          "ex": "The royal wedding was all about the pageantry.",
          "exKo": "그 왕실 결혼식은 온통 화려한 볼거리뿐이었다."
        },
        {
          "term": "dangerously close to",
          "ko": "위험할 만큼 ~에 가까운, 거의 ~할 지경인",
          "type": "phrase",
          "easy": "조금만 더 하면 안 좋은 일이 벌어질 만큼 아슬아슬하게 가까운 상태.",
          "ex": "You're dangerously close to losing your job.",
          "exKo": "너 지금 일자리 잃기 직전이야."
        }
      ]
    },
    {
      "start": 18,
      "end": 22.92,
      "lines": [
        {
          "text": "It's so quiet. Where is everyone?",
          "start": 18,
          "end": 19.84
        },
        {
          "text": "Well, Stan's on a mission, so everyone's doing whatever they want.",
          "start": 19.84,
          "end": 22.92
        }
      ],
      "glossary": [
        {
          "term": "on a mission",
          "ko": "임무 수행 중인",
          "type": "phrase",
          "easy": "맡은 임무를 하러 나가 있는 상태. 여기선 스파이 임무.",
          "tip": "비유로 'be on a mission'은 '뭔가에 단단히 꽂혀 몰두하다'라는 뜻도 된다."
        }
      ]
    },
    {
      "start": 22.96,
      "end": 30.64,
      "lines": [
        {
          "text": "Steve's wrestling in the basement, and Hayley's finally getting into it with direct TV.",
          "start": 22.96,
          "end": 27.36
        },
        {
          "text": "Listen Randall, I know this isn't your fault.",
          "start": 28.26,
          "end": 30.64
        }
      ],
      "glossary": [
        {
          "term": "get into it with",
          "ko": "~와 한판 붙다, 말다툼하다",
          "type": "idiom",
          "easy": "누군가와 심하게 다투거나 언쟁을 벌이다.",
          "nuance": "여기선 케이블TV 회사(직원)와 전화로 실랑이를 벌이는 상황. 단순 대화가 아니라 갈등.",
          "when": "고객센터·상대와 따지고 싸울 때.",
          "ex": "He got into it with the referee over the call.",
          "exKo": "그는 그 판정 때문에 심판과 한판 붙었다."
        },
        {
          "term": "solid dude",
          "ko": "괜찮은/믿음직한 녀석",
          "type": "phrase",
          "easy": "성격 좋고 믿을 만한 사람을 가리키는 캐주얼한 표현.",
          "nuance": "solid는 사람한테 쓰면 '듬직하고 믿을 만한'. dude는 친근한 '남자, 녀석'."
        }
      ]
    },
    {
      "start": 30.64,
      "end": 35.44,
      "lines": [
        {
          "text": "You seem like a really solid dude.",
          "start": 30.64,
          "end": 32.84
        },
        {
          "text": "So you say your husband's gone?",
          "start": 32.84,
          "end": 35.44
        }
      ]
    },
    {
      "start": 35.48,
      "end": 38.44,
      "lines": [
        {
          "text": "Yeah.",
          "start": 35.48,
          "end": 35.98
        },
        {
          "text": "And you say my husband's gone?",
          "start": 36.1,
          "end": 38.44
        }
      ]
    },
    {
      "start": 38.44,
      "end": 40.7,
      "lines": [
        {
          "text": "I didn't say that.",
          "start": 38.44,
          "end": 39.8
        },
        {
          "text": "Well, he is.",
          "start": 39.84,
          "end": 40.7
        }
      ]
    },
    {
      "start": 41.13,
      "end": 46.56,
      "lines": [
        {
          "text": "Which makes us both - Widows! - Widows!",
          "start": 41.13,
          "end": 45.04
        },
        {
          "text": "I love the Widow game.",
          "start": 45.08,
          "end": 46.56
        }
      ],
      "glossary": [
        {
          "term": "catching on",
          "ko": "알아차리다, 눈치채다",
          "type": "phrase",
          "easy": "무슨 일이 벌어지는지 뒤늦게 이해하거나 알아채다.",
          "nuance": "catch on은 '이해가 딱 오다' 또는 '유행하다' 두 뜻. 여기선 '눈치채다'.",
          "ex": "It took him a while to catch on to the joke.",
          "exKo": "그는 그 농담을 알아채는 데 한참 걸렸다.",
          "vs": "understand는 차분히 '이해하다', catch on은 '뒤늦게 감 잡다' 느낌."
        }
      ]
    },
    {
      "start": 46.56,
      "end": 50.04,
      "lines": [
        {
          "text": "But you never love catching on when I'm trying to get you to play it.",
          "start": 46.56,
          "end": 48.92
        },
        {
          "text": "You know I don't.",
          "start": 48.92,
          "end": 50.04
        }
      ]
    },
    {
      "start": 52.58,
      "end": 57.04,
      "lines": [
        {
          "text": "Just some steak for a tragically young widow, please.",
          "start": 52.58,
          "end": 55.92
        },
        {
          "text": "Which kind would you like?",
          "start": 55.92,
          "end": 57.04
        }
      ],
      "glossary": [
        {
          "term": "tragically young",
          "ko": "비극적으로 젊은, 너무 일찍 (상을 당한)",
          "type": "phrase",
          "easy": "이렇게 젊은데 안된 일을 겪어 안쓰럽다는 과장된 표현.",
          "nuance": "여기선 동정을 사려고 일부러 불쌍하게 말하는 코미디적 과장."
        }
      ]
    },
    {
      "start": 57.08,
      "end": 60.95,
      "lines": [
        {
          "text": "There are different kinds?",
          "start": 57.08,
          "end": 58.88
        },
        {
          "text": "My dead husband buys.",
          "start": 59.16,
          "end": 60.95
        }
      ]
    },
    {
      "start": 61.32,
      "end": 65.64,
      "lines": [
        {
          "text": "I'm sorry.",
          "start": 61.32,
          "end": 62
        },
        {
          "text": "My dead husband used to buy our steaks.",
          "start": 62.32,
          "end": 65.64
        }
      ]
    },
    {
      "start": 66.08,
      "end": 70.24,
      "lines": [
        {
          "text": "As I said, I'm a widow.",
          "start": 66.08,
          "end": 68.6
        },
        {
          "text": "Ribeye is the best.",
          "start": 68.8,
          "end": 70.24
        }
      ]
    },
    {
      "start": 70.24,
      "end": 79.49,
      "lines": [
        {
          "text": "But does it also cost the least?",
          "start": 70.24,
          "end": 72.84
        },
        {
          "text": "Since my husband died, I've been so overwhelmed learning what different things cost.",
          "start": 73.04,
          "end": 79.49
        }
      ]
    },
    {
      "start": 79.49,
      "end": 83.48,
      "lines": [
        {
          "text": "For a widow, it's on the house.",
