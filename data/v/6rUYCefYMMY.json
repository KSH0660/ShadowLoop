        {
          "term": "drop it in the sack",
          "ko": "봉지에 담아 줘",
          "type": "phrase",
          "easy": "sack은 종이/비닐 봉지. 그냥 봉지에 넣어 달라는 말."
        }
      ]
    },
    {
      "start": 85.72,
      "end": 89.04,
      "lines": [
