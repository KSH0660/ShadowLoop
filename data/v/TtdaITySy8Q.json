{
  "id": "TtdaITySy8Q",
  "segments": [
    {
      "start": 0.2,
      "end": 5.92,
      "lines": [
        {
          "text": "Hey, Miller, your toes are looking a little lonely. Why don't you pay him a visit?",
          "start": 0.2,
          "end": 3.04
        },
        {
          "text": "What's with the extra warm ups, Coach? These guys haven't won all year.",
          "start": 3.08,
          "end": 5.92
        }
      ],
      "glossary": [
        {
          "term": "What's with ...?",
          "ko": "~는 웬일이야?, ~는 왜 그래?",
          "type": "idiom"
        }
      ]
    },
    {
      "start": 5.92,
      "end": 11.82,
      "lines": [
        {
          "text": "Did you hear that, team? Miller just bought you a little present.",
          "start": 5.92,
          "end": 9.16
        },
        {
          "text": "I wasn't complaining, I was just wondering why we- Take a lap.",
          "start": 9.16,
          "end": 11.82
        }
      ],
      "glossary": [
        {
          "term": "Take a lap",
          "ko": "(벌로) 운동장 한 바퀴 뛰어",
          "type": "idiom"
        }
      ]
    },
    {
      "start": 12.96,
      "end": 15.85,
      "lines": [
        {
          "text": "Bert Lavoisier.",
          "start": 12.96,
          "end": 14.56
        },
        {
          "text": "Red Stag.",
          "start": 14.68,
          "end": 15.85
        }
      ]
    },
    {
      "start": 16.51,
      "end": 22.31,
      "lines": [
        {
          "text": "Ducky Pond.",
          "start": 16.51,
          "end": 17.72
        },
        {
          "text": "All coaching legends at this high school and none have won more than two games their first season.",
          "start": 18.02,
          "end": 22.31
        }
      ],
      "glossary": [
        {
          "term": "coaching legends",
          "ko": "전설적인 코치들",
          "type": "phrase"
        }
      ]
    },
    {
      "start": 22.31,
      "end": 30.32,
      "lines": [
        {
          "text": "I win today, that makes three, making me the winningest first year freshman coach ever.",
          "start": 22.31,
          "end": 27.44
        },
        {
          "text": "Oh hey, Luke. Reuben's sick.",
          "start": 28.68,
          "end": 30.32
        }
      ],
      "glossary": [
        {
          "term": "winningest",
          "ko": "가장 많이 이긴 (구어)",
          "type": "word"
        }
      ]
    },
    {
      "start": 30.32,
      "end": 35.08,
      "lines": [
        {
          "text": "So I'm going to need you to be the announcer today.",
          "start": 30.32,
          "end": 32.36
        },
        {
          "text": "How am I supposed to keep score and announce at the same time?",
          "start": 32.36,
          "end": 35.08
        }
      ],
      "glossary": [
        {
          "term": "spaz",
          "ko": "얼간이, 어수룩한 사람 (속어)",
          "type": "word"
        },
        {
          "term": "dork",
          "ko": "멍청이, 찐따 (속어)",
          "type": "word"
        }
      ]
    },
    {
      "start": 35.12,
      "end": 37.88,
      "lines": [
        {
          "text": "Same way you're a spaz and a dork at the same time.",
          "start": 35.12,
          "end": 37.36
        },
        {
          "text": "Spork.",
          "start": 37.4,
          "end": 37.88
        }
      ],
      "glossary": [
        {
          "term": "lose the attitude",
          "ko": "그 건방진 태도 좀 버려",
          "type": "idiom"
        },
        {
          "term": "intensity",
          "ko": "(여기) 기세, 열의",
          "type": "word"
        }
      ]
    },
    {
      "start": 37.88,
      "end": 40.77,
      "lines": [
        {
          "text": "Okay, lose the attitude.",
          "start": 37.88,
          "end": 39.16
        },
        {
          "text": "But keep that intensity.",
          "start": 39.16,
          "end": 40.77
        }
      ]
    },
    {
      "start": 43.64,
      "end": 48,
      "lines": [
        {
          "text": "Excuse me, ref, what's with all the black armbands?",
          "start": 43.64,
          "end": 46
        },
        {
          "text": "Their coach passed away last night.",
          "start": 46.04,
          "end": 48
        }
      ],
      "glossary": [
        {
          "term": "armbands",
          "ko": "(애도용) 완장",
          "type": "word"
        },
        {
          "term": "passed away",
          "ko": "돌아가시다, 별세하다",
          "type": "idiom"
        }
      ]
    },
    {
      "start": 48.04,
      "end": 50.08,
      "lines": [
        {
          "text": "He'd been sick for a while.",
          "start": 48.04,
          "end": 49.24
        },
        {
          "text": "That's terrible.",
          "start": 49.28,
          "end": 50.08
        }
      ]
    },
    {
      "start": 50.44,
      "end": 54.68,
      "lines": [
        {
          "text": "And we're still playing?",
          "start": 50.44,
          "end": 51.44
        },
        {
          "text": "Oh, they're tough kids. Roger Knight lived for high school football.",
          "start": 51.48,
          "end": 54.68
        }
      ],
      "glossary": [
        {
          "term": "tough kids",
          "ko": "강단 있는, 근성 있는 아이들",
          "type": "phrase"
        },
        {
          "term": "lived for",
          "ko": "~을 낙으로 삼다, ~에 목숨 걸다",
          "type": "idiom"
        }
      ]
    },
    {
      "start": 54.68,
      "end": 59.6,
      "lines": [
        {
          "text": "So they're playing this one in his honor.",
          "start": 54.68,
          "end": 56.44
        },
        {
          "text": "Okay. Hey, guys. Guys, guys, guys, tragic news about Coach Knight.",
          "start": 56.48,
          "end": 59.6
        }
      ],
      "glossary": [
        {
          "term": "in his honor",
          "ko": "그를 기리며",
          "type": "phrase"
        }
      ]
    },
    {
      "start": 60.09,
      "end": 65.73,
      "lines": [
        {
          "text": "You know what we need to focus up.",
          "start": 60.09,
          "end": 61.69
        },
        {
          "text": "Plenty of time to pay our respects. But there will be no mourning night this afternoon.",
          "start": 62.21,
          "end": 65.73
        }
      ],
      "glossary": [
        {
          "term": "focus up",
          "ko": "정신 집중하자",
          "type": "phrase"
        },
        {
          "term": "pay our respects",
          "ko": "조의를 표하다, 애도하다",
          "type": "idiom"
        }
      ]
    },
    {
      "start": 66.89,
      "end": 68.63,
      "lines": [
        {
          "text": "A lot of character over there.",
          "start": 66.89,
          "end": 68.09
        },
        {
          "text": "Yeah.",
          "start": 68.13,
          "end": 68.63
        }
      ],
      "glossary": [
        {
          "term": "a lot of character",
          "ko": "근성·기개가 대단함",
          "type": "phrase"
        }
      ]
    },
    {
      "start": 68.89,
      "end": 72.29,
      "lines": [
        {
          "text": "Those kids haven't won a game all year. - Uh huh.",
          "start": 68.89,
          "end": 70.49
        },
        {
          "text": "And now to have to play on his birthday.",
          "start": 70.49,
          "end": 72.29
        }
      ]
    },
    {
      "start": 72.33,
      "end": 76.21,
      "lines": [
        {
          "text": "Okay, see you at the coin toss.",
          "start": 72.33,
          "end": 73.72
        },
        {
          "text": "Top of the morning!",
          "start": 75.03,
          "end": 76.21
        }
      ]
    },
    {
      "start": 77.65,
      "end": 84.69,
      "lines": [
        {
          "text": "Real estate, and to a lesser extent, life is all about perseverance.",
          "start": 77.65,
          "end": 81.13
        },
        {
          "text": "Things go wrong. Keys get lost.",
          "start": 82.09,
          "end": 84.69
        }
      ],
      "glossary": [
        {
          "term": "perseverance",
          "ko": "끈기, 인내",
          "type": "word"
        },
        {
          "term": "things go wrong",
          "ko": "일이 틀어지다",
          "type": "idiom"
        }
      ]
    },
    {
      "start": 84.69,
      "end": 89.73,
      "lines": [
        {
          "text": "Deals fall through, keys get misplaced.",
          "start": 84.69,
          "end": 87.01
        },
        {
          "text": "A lot of it has to do with keys.",
          "start": 88.05,
          "end": 89.73
        }
      ],
      "glossary": [
        {
          "term": "deals fall through",
          "ko": "거래가 무산되다",
          "type": "idiom"
        },
        {
          "term": "get misplaced",
          "ko": "어디 뒀는지 모르게 되다",
          "type": "phrase"
        }
      ]
    },
    {
      "start": 89.73,
      "end": 99.09,
      "lines": [
        {
          "text": "But that's when you find out there are two types of people those who waste time staring at a closed door and those who find a window.",
          "start": 89.73,
          "end": 99.09
        }
      ],
      "glossary": [
        {
          "term": "those who stare at a closed door vs. those who find a window",
          "ko": "닫힌 문만 보는 사람과 (다른) 창문을 찾는 사람",
          "type": "idiom"
        }
      ]
    },
    {
      "start": 108.45,
      "end": 114.65,
      "lines": [
        {
          "text": "I'm looking at my first month ever without a sale.",
          "start": 108.45,
          "end": 110.65
        },
        {
          "text": "Some people might give up, but those people aren't Phil Dunphy.",
          "start": 110.93,
          "end": 114.65
        }
      ]
    },
    {
      "start": 115.65,
      "end": 118.81,
      "lines": [
        {
          "text": "No!",
          "start": 115.65,
          "end": 116.21
        },
        {
          "text": "It's like I tell my kids.",
          "start": 117.65,
          "end": 118.81
        }
      ]
    },
    {
      "start": 120.54,
      "end": 131.62,
      "lines": [
        {
          "text": "Keep a positive attitude and things will fall your way.",
          "start": 120.54,
          "end": 123.34
        },
        {
          "text": "As my favorite redhead once sang, The sun will come out tomorrow.",
          "start": 127.26,
          "end": 131.62
        }
      ],
      "glossary": [
        {
          "term": "things will fall your way",
          "ko": "일이 술술 잘 풀리다",
          "type": "idiom"
        }
      ]
    },
    {
      "start": 138.98,
      "end": 155.86,
      "lines": [
        {
          "text": "That redhead, of course, was Mitchell introducing me to the plucky orphan Annie.",
          "start": 138.98,
          "end": 143.44
        },
        {
          "text": "Whose never say die attitude pulled this country out of a little thing called the Great Depression.",
          "start": 149.02,
          "end": 155.86
        }
      ],
      "glossary": [
        {
          "term": "plucky",
          "ko": "당찬, 용감한",
          "type": "word"
        },
        {
          "term": "orphan",
          "ko": "고아",
          "type": "word"
        }
      ]
    },
    {
      "start": 157.02,
      "end": 162.28,
      "lines": [
        {
          "text": "And anything a little girl can do, I can try to do too.",
          "start": 157.02,
          "end": 160.72
        },
        {
          "text": "Hey!",
          "start": 161.78,
          "end": 162.28
        }
      ],
      "glossary": [
        {
          "term": "never-say-die attitude",
          "ko": "절대 포기하지 않는 태도",
          "type": "idiom"
        }
      ]
    },
    {
      "start": 183.79,
      "end": 194.23,
      "lines": [
        {
          "text": "Hey, guys. Welcome back. Drink it in.",
          "start": 183.79,
          "end": 186.71
        },
        {
          "text": "Pretty great, huh? Oh, am I glad you guys could see this during the daytime.",
          "start": 189.55,
          "end": 194.23
        }
      ]
    },
    {
      "start": 194.27,
      "end": 200.39,
      "lines": [
        {
          "text": "I really think it shows better like that.",
          "start": 194.27,
          "end": 196.79
        },
        {
          "text": "So should we just cut to the chase and pay me my commission?",
          "start": 197.11,
          "end": 200.39
        }
      ],
      "glossary": [
        {
          "term": "cut to the chase",
          "ko": "본론으로 바로 들어가다",
          "type": "idiom"
        },
        {
          "term": "commission",
          "ko": "수수료, 중개 보수",
          "type": "word"
        }
      ]
    },
    {
      "start": 200.71,
      "end": 205.67,
      "lines": [
        {
          "text": "I'm kidding. You don't pay me directly. There is no fee in Dunphil.",
          "start": 200.71,
          "end": 204.03
        },
        {
          "text": "Listen, Phil, we've got some great news.",
          "start": 204.11,
          "end": 205.67
        }
      ],
      "glossary": [
        {
          "term": "in person",
          "ko": "직접, 대면으로",
          "type": "phrase"
        }
      ]
    },
    {
      "start": 205.71,
      "end": 209.31,
      "lines": [
        {
          "text": "I love it. Where's my lucky pen?",
          "start": 205.71,
          "end": 207.59
        },
        {
          "text": "We wanted to tell you this in person.",
          "start": 207.63,
          "end": 209.31
        }
      ]
    },
    {
      "start": 209.35,
      "end": 211.19,
      "lines": [
        {
          "text": "We just came from the doctor.",
          "start": 209.35,
          "end": 210.39
        },
        {
          "text": "I'm pregnant.",
          "start": 210.43,
          "end": 211.19
        }
      ]
    },
    {
      "start": 211.27,
      "end": 217.11,
      "lines": [
        {
          "text": "Oh my God, you guys.",
          "start": 211.27,
          "end": 214.11
        },
        {
          "text": "Except we decided to put off buying the house until after the baby's born.",
          "start": 214.11,
          "end": 217.11
        }
      ]
    },
    {
      "start": 217.15,
      "end": 219.43,
      "lines": [
        {
          "text": "Sure.",
          "start": 217.15,
          "end": 217.76
        },
        {
          "text": "We've been trying for, like, six years.",
          "start": 217.76,
          "end": 219.43
        }
      ],
      "glossary": [
        {
          "term": "put off",
          "ko": "미루다, 연기하다",
          "type": "idiom"
        }
      ]
    },
    {
      "start": 219.47,
      "end": 222.27,
      "lines": [
        {
          "text": "Sure.",
          "start": 219.47,
          "end": 219.91
        },
        {
          "text": "For a while there, it seemed like the universe was against us.",
          "start": 219.91,
          "end": 222.27
        }
      ],
      "glossary": [
        {
          "term": "the universe was against us",
          "ko": "온 세상이 우릴 막는 것 같았다",
          "type": "idiom"
        }
      ]
    },
    {
      "start": 222.31,
      "end": 224.79,
      "lines": [
        {
          "text": "That's ridiculous. Why would the universe be against one person?",
          "start": 222.31,
          "end": 224.79
        }
      ]
    }
  ]
}
